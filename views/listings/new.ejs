<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>wanderLust</title>
</head>
<body>
    <h1>Create a New Listing</h1>
    <form method="POST" action="/listings">
        <input type="text" name="title" placeholder="add Title">
    <br><br>
    <textarea name="description" placeholder="add Description"></textarea>
    <br><br>
    <input type = "number" name="price" placeholder="add Price">
    <br><br>
    <input type="text" name="location" placeholder="add Location">
    <br><br>
    <input type="text" name="country" placeholder="add Country">
    <input type="text" name="image" placeholder="add Image URL">
    <br><br>
    <button type="submit">Create Listing</button>
    </form>
</body>
</html>