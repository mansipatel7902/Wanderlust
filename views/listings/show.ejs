<% layout("layouts/boilerplate") %>
<div class="row mt-4">
    <div class="col-8 offset-3">
            <h1>Listing in detail:</h1>
            <div class="show-card">
                <div class="col-7">
                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image">
                </div>
                <div class="card-body">
                    <h3 class="card-title">Title: <%= listing.title %></h3>
                    <div class="card-text">
                        <p>Description: <%= listing.description %> </p>
                        <p>Price: &#8377; <%= listing.price.toLocaleString("en-IN") %> / night</p>
                        <p>Location: <%= listing.location %> </p>
                        <p>Country: <%= listing.country %> </p></div>
                    </div>
            </div>
            <div class="btns mt-4">
                <a href="/listings/<%=listing._id %>/edit" class="btn btn-success col-1 offset-2">Edit</a>
                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-danger offset-3" >Delete</button>
                </form>
            </div>
    </div>
</div>

